# syntax=docker/dockerfile:1.7

FROM gradle:8.14.3-jdk17 AS base

WORKDIR /workspace
ENV GRADLE_USER_HOME=/home/gradle/.gradle

COPY gradlew build.gradle settings.gradle ./
COPY gradle ./gradle
RUN chmod +x ./gradlew
RUN --mount=type=cache,target=/home/gradle/.gradle \
    --mount=type=cache,target=/workspace/.gradle \
    ./gradlew --no-daemon --build-cache help

FROM base AS source
COPY src ./src

FROM source AS tester
RUN --mount=type=cache,target=/home/gradle/.gradle \
    --mount=type=cache,target=/workspace/.gradle \
    ./gradlew --no-daemon --build-cache -PskipDockerlessTestcontainers=true test

FROM tester AS docs
RUN --mount=type=cache,target=/home/gradle/.gradle \
    --mount=type=cache,target=/workspace/.gradle \
    ./gradlew --no-daemon --build-cache asciidoctor -x test

FROM tester AS builder
RUN --mount=type=cache,target=/home/gradle/.gradle \
    --mount=type=cache,target=/workspace/.gradle \
    ./gradlew --no-daemon --build-cache bootJar -x test

FROM eclipse-temurin:17-jre

WORKDIR /app
COPY --from=builder /workspace/build/libs/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
