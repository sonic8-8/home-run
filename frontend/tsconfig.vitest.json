{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": [
    "tests/setup.ts",
    "tests/unit/**/*.test.ts",
    "tests/unit/**/*.test.tsx",
    "tests/unit/**/*.spec.ts",
    "tests/unit/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ],
  "exclude": []
}
