import groovy.json.JsonOutput

def sendMattermostNotification(String status) {
    def color = status == 'SUCCESS' ? '#2EB67D' : '#D24B4E'
    def statusLabel = status == 'SUCCESS' ? '성공' : '실패'
    def commitMessage = env.GIT_COMMIT_MESSAGE ?: 'unknown'
    def failedStage = env.PIPELINE_STAGE ?: 'unknown'
    def detailLines = [
        "메시지: ${commitMessage}",
        "빌드 URL: ${env.BUILD_URL ?: 'N/A'}"
    ]

    if (status == 'FAILURE') {
        detailLines.add(1, "실패 단계: ${failedStage}")
    }

    def payload = JsonOutput.toJson([
        attachments: [[
            color: color,
            title: "${env.JOB_NAME} #${env.BUILD_NUMBER} 배포 ${statusLabel}",
            title_link: env.BUILD_URL ?: '',
            text: detailLines.join('\n')
        ]]
    ])

    writeFile file: 'mattermost-payload.json', text: payload

    withCredentials([string(credentialsId: 'mattermost-webhook-url', variable: 'MM_WEBHOOK_URL')]) {
        def exitCode = sh(
            script: '''
            curl -sS -X POST \
              -H "Content-Type: application/json" \
              --data @mattermost-payload.json \
              "$MM_WEBHOOK_URL"
            ''',
            returnStatus: true
        )

        if (exitCode != 0) {
            echo "Mattermost notification failed with exit code ${exitCode}"
        }
    }

    sh 'rm -f mattermost-payload.json'
}

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        FRONTEND_IMAGE = 'homerun-frontend:develop'
        BACKEND_IMAGE = 'homerun-backend:develop'
        BACKEND_DOCS_IMAGE = 'homerun-backend-docs:develop'
        BACKEND_BUILDKIT_DOCKERFILE = 'backend/Dockerfile.buildkit-cache'
        COMPOSE_FILE = 'infrastructure/docker/docker-compose.runtime.yml'
        OBSERVABILITY_COMPOSE_FILE = 'infrastructure/docker/docker-compose.observability.yml'
        ENV_FILE = '.env.runtime'
        FRONTEND_HOST_PORT = '3000'
        BACKEND_HOST_PORT = '8081'
        POSTGRES_HOST_PORT = '5432'
        REDIS_HOST_PORT = '6379'
        PUBLIC_BASE_URL = 'https://j14c103.p.ssafy.io'
        POSTGRES_DB = 'homerun'
        POSTGRES_USER = 'homerun_user'
        POSTGRES_PASSWORD = credentials('homerun-postgres-password')
        SSAFY_API_KEY = credentials('ssafy-api-key')
        SSAFY_ACCOUNT_TYPE_UNIQUE_NO = credentials('SSAFY_ACCOUNT_TYPE_UNIQUE_NO')
        KIS_APP_KEY = credentials('KIS_APP_KEY')
        KIS_APP_SECRET = credentials('KIS_APP_SECRET')
        PUBLIC_DATA_SERVICE_KEY = credentials('public-data-service-key')
        NAVER_GEOCODING_CLIENT_ID = credentials('naver-geocoding-client-id')
        NAVER_GEOCODING_CLIENT_SECRET = credentials('naver-geocoding-client-secret')
        // Disable this after the one-time December 2025 Seoul bootstrap import succeeds.
        REAL_ESTATE_IMPORT_ENABLED = 'true'
        REAL_ESTATE_IMPORT_REGIONS = 'SEOUL'
        REAL_ESTATE_IMPORT_FROM_YEAR_MONTH = '2025-12'
        REAL_ESTATE_IMPORT_TO_YEAR_MONTH = '2025-12'
        REAL_ESTATE_IMPORT_DATASET_TYPES = 'APT_SALE'
    }

    stages {
        stage('Checkout Info') {
            steps {
                script {
                    env.PIPELINE_STAGE = 'Checkout Info'
                    env.GIT_BRANCH_NAME = sh(script: 'git branch --show-current || true', returnStdout: true).trim()
                    env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.GIT_COMMIT_MESSAGE = sh(script: "git log -1 --pretty=%s", returnStdout: true).trim()
                }
                sh 'git branch --show-current || true'
                sh 'git rev-parse --short HEAD'
                sh 'git log -1 --pretty=%s'
            }
        }

        stage('Validate And Test') {
            parallel {
                stage('Frontend Validate') {
                    steps {
                        script {
                            env.PIPELINE_STAGE = 'Frontend Validate'
                        }
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            sh 'docker build --target validator -t homerun-frontend-validator -f frontend/Dockerfile frontend'
                        }
                    }
                }

                stage('Backend Test') {
                    steps {
                        script {
                            env.PIPELINE_STAGE = 'Backend Test'
                        }
                        sh '''
                            docker buildx build \
                              --progress=plain \
                              --load \
                              --target tester \
                              -t homerun-backend-tester \
                              -f ${BACKEND_BUILDKIT_DOCKERFILE} \
                              backend
                        '''
                    }
                }
            }
        }

        stage('Build Runtime Images') {
            steps {
                script {
                    env.PIPELINE_STAGE = 'Build Runtime Images'
                }
                sh '''
                    rm -rf frontend/generated-docs
                    mkdir -p frontend/generated-docs
                '''
                sh '''
                    docker buildx build \
                      --progress=plain \
                      --load \
                      --target docs \
                      -t ${BACKEND_DOCS_IMAGE} \
                      -f ${BACKEND_BUILDKIT_DOCKERFILE} \
                      backend
                '''
                sh '''
                    DOCS_CONTAINER=$(docker create ${BACKEND_DOCS_IMAGE})
                    trap 'docker rm -f "$DOCS_CONTAINER" >/dev/null 2>&1 || true' EXIT

                    docker cp "$DOCS_CONTAINER":/workspace/build/docs/asciidoc/. frontend/generated-docs/
                    test -f frontend/generated-docs/index.html

                    docker rm -f "$DOCS_CONTAINER" >/dev/null 2>&1 || true
                    trap - EXIT
                '''
                script {
                    parallel(
                        'Frontend Runtime Image': {
                            sh '''
                                docker build \
                                  --build-arg VITE_NAVER_MAP_CLIENT_ID=${NAVER_GEOCODING_CLIENT_ID} \
                                  -t ${FRONTEND_IMAGE} \
                                  -f frontend/Dockerfile \
                                  frontend
                            '''
                        },
                        'Backend Runtime Image': {
                            sh '''
                                docker buildx build \
                                  --progress=plain \
                                  --load \
                                  -t ${BACKEND_IMAGE} \
                                  -f ${BACKEND_BUILDKIT_DOCKERFILE} \
                                  backend
                            '''
                        }
                    )
                }
            }
        }

        stage('Deploy Runtime') {
            steps {
                script {
                    env.PIPELINE_STAGE = 'Deploy Runtime'
                }
                writeFile file: env.ENV_FILE, text: """
FRONTEND_HOST_PORT=${env.FRONTEND_HOST_PORT}
BACKEND_HOST_PORT=${env.BACKEND_HOST_PORT}
POSTGRES_HOST_PORT=${env.POSTGRES_HOST_PORT}
REDIS_HOST_PORT=${env.REDIS_HOST_PORT}
PUBLIC_BASE_URL=${env.PUBLIC_BASE_URL ?: ''}
POSTGRES_DB=${env.POSTGRES_DB}
POSTGRES_USER=${env.POSTGRES_USER}
POSTGRES_PASSWORD=${env.POSTGRES_PASSWORD}
SSAFY_API_KEY=${env.SSAFY_API_KEY}
SSAFY_ACCOUNT_TYPE_UNIQUE_NO=${env.SSAFY_ACCOUNT_TYPE_UNIQUE_NO}
KIS_APP_KEY=${env.KIS_APP_KEY}
KIS_APP_SECRET=${env.KIS_APP_SECRET}
PUBLIC_DATA_SERVICE_KEY=${env.PUBLIC_DATA_SERVICE_KEY}
NAVER_GEOCODING_CLIENT_ID=${env.NAVER_GEOCODING_CLIENT_ID}
NAVER_GEOCODING_CLIENT_SECRET=${env.NAVER_GEOCODING_CLIENT_SECRET}
REAL_ESTATE_IMPORT_ENABLED=${env.REAL_ESTATE_IMPORT_ENABLED}
REAL_ESTATE_IMPORT_REGIONS=${env.REAL_ESTATE_IMPORT_REGIONS}
REAL_ESTATE_IMPORT_FROM_YEAR_MONTH=${env.REAL_ESTATE_IMPORT_FROM_YEAR_MONTH}
REAL_ESTATE_IMPORT_TO_YEAR_MONTH=${env.REAL_ESTATE_IMPORT_TO_YEAR_MONTH}
REAL_ESTATE_IMPORT_DATASET_TYPES=${env.REAL_ESTATE_IMPORT_DATASET_TYPES}
FRONTEND_IMAGE=${env.FRONTEND_IMAGE}
BACKEND_IMAGE=${env.BACKEND_IMAGE}
""".trim() + "\n"

                sh '''
                    docker compose \
                      --env-file ${ENV_FILE} \
                      -f ${COMPOSE_FILE} \
                      -f ${OBSERVABILITY_COMPOSE_FILE} \
                      up -d postgres redis backend frontend prometheus grafana
                '''
            }
        }

        stage('Verify Runtime Startup') {
            steps {
                script {
                    env.PIPELINE_STAGE = 'Verify Runtime Startup'
                }
                sh '''
                    for i in $(seq 1 60); do
                      if ! docker ps --format '{{.Names}}' | grep -qx homerun-backend; then
                        docker logs --tail=200 homerun-backend || true
                        exit 1
                      fi

                      if ! docker ps --format '{{.Names}}' | grep -qx homerun-frontend; then
                        docker logs --tail=200 homerun-frontend || true
                        exit 1
                      fi

                      if docker exec homerun-frontend sh -c "wget -qO- http://backend:8080/actuator/health/liveness >/dev/null" && \
                         docker exec homerun-frontend sh -c "wget -qO- http://backend:8080/actuator/health/readiness >/dev/null"; then
                        exit 0
                      fi

                      sleep 2
                    done

                    docker logs --tail=200 homerun-backend || true
                    docker logs --tail=200 homerun-frontend || true
                    exit 1
                '''
            }
        }

        stage('Verify Frontend HTTP') {
            steps {
                script {
                    env.PIPELINE_STAGE = 'Verify Frontend HTTP'
                }
                sh '''
                    for i in $(seq 1 30); do
                      if ! docker ps --format '{{.Names}}' | grep -qx homerun-frontend; then
                        docker logs --tail=200 homerun-frontend || true
                        exit 1
                      fi

                      if ! docker ps --format '{{.Names}}' | grep -qx homerun-grafana; then
                        docker logs --tail=200 homerun-grafana || true
                        exit 1
                      fi

                      if docker exec homerun-frontend sh -c "wget -qO- http://127.0.0.1/ >/dev/null" && \
                         docker exec homerun-frontend sh -c "wget -qO- http://127.0.0.1/docs/ >/dev/null" && \
                         docker exec homerun-frontend sh -c "wget -qO- http://127.0.0.1/grafana >/dev/null"; then
                        exit 0
                      fi

                      sleep 2
                    done

                    docker logs --tail=200 homerun-frontend || true
                    docker logs --tail=200 homerun-grafana || true
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            script {
                sendMattermostNotification('SUCCESS')
            }
        }
        failure {
            script {
                sendMattermostNotification('FAILURE')
            }
        }
        always {
            sh '''
                if [ -f "${ENV_FILE}" ]; then
                  docker compose \
                    --env-file ${ENV_FILE} \
                    -f ${COMPOSE_FILE} \
                    -f ${OBSERVABILITY_COMPOSE_FILE} \
                    ps
                fi
            '''
            sh 'rm -f ${ENV_FILE}'
            sh 'rm -rf frontend/generated-docs'
            sh 'rm -f mattermost-payload.json'
        }
    }
}
